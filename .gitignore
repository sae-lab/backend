application-local.yml
application-*.local.yml

# Environment variables
.env
.env.*
!.env.example

# IntelliJ HTTP Client의 개인 테스트 계정·비밀번호와 로컬 테스트 이미지
http-client.private.env.json
http-client.private/
http-client_private/


# ==============================
# Project Personal Files
# ==============================

# Personal development notes
.local/

# Project documents not tracked
PROJECT_DOCS.md

# AI assistant configuration
GEMINI.md


# ==============================
# User-uploaded content
# ==============================

/uploads/


