# Java Tools
# ==============================

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/


# ==============================
# IntelliJ IDEA
# ==============================

# IDE settings
.idea/
*.iml


# ==============================
# Environment & Secrets
# ==============================

