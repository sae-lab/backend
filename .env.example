# Database
DB_URL=jdbc:postgresql://localhost:5432/sightseeing
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Application secrets and external APIs
JWT_SECRET=change-me-to-a-long-random-value
API_TOKEN=change-me
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
ROUTE_API_BASE_URL=https://apis.data.go.kr/B551011/Durunubi
KAKAO_API_KEY=change-me

# Local storage is the default for Podman and developer machines.
STORAGE_TYPE=local
FILE_UPLOAD_DIR=./.local/uploads
IMAGE_MAX_FILE_SIZE=10MB
IMAGE_MAX_REQUEST_SIZE=12MB

# Set STORAGE_TYPE=r2 and fill these only when testing R2 or deploying Render.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=kangwonroad-dev
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_PUBLIC_BASE_URL=https://pub-example.r2.dev
R2_OBJECT_PREFIX=dev
